#!/usr/bin/env php
<?php

// Autoloader paths (tries multiple locations)
$autoloadPaths = [
    __DIR__ . '/../../../autoload.php', // Installed as dependency
    __DIR__ . '/../vendor/autoload.php', // Standalone
];

foreach ( $autoloadPaths as $file )
{
    if ( file_exists( $file ) )
    {
        require $file;
        break;
    }
}

use BracketSmith\BracketSmith;

$options = [];
$files = [];
$end_options = false;
foreach ( array_slice( $argv, 1 ) as $argument )
{
    if ( ! $end_options && $argument === '--' )
    {
        $end_options = true;
        continue;
    }

    if ( ! $end_options && str_starts_with( $argument, '-' ) )
    {
        if ( ! in_array( $argument, [ '--dry-run', '--verbose', '--help' ], true ) )
        {
            fwrite( STDERR, "BracketSmith: Unknown option: $argument\n" );
            exit( 1 );
        }
        $options[ substr( $argument, 2 ) ] = true;
    }
    else
    {
        $files[] = $argument;
    }
}

// Show help
if ( isset( $options[ "help" ] ) )
{
    echo "BracketSmith - Array Spacing Formatter\n\n";
    echo "Usage: bracketsmith [options] [files...]\n\n";
    echo "Options:\n";
    echo "  --dry-run    Check without modifying files\n";
    echo "  --verbose    Detailed output\n";
    echo "  --help       Show this help\n\n";
    echo "Use -- before file names that start with a dash.\n\n";
    echo "If no files are specified, processes: app/, config/, database/, lang/, routes/\n";

    exit( 0 );
}

$dry_run = isset( $options[ "dry-run" ] );
$verbose = isset( $options[ "verbose" ] );

try
{
    $smith = new BracketSmith( $dry_run, $verbose );
    exit( $smith->run( $files ) ? 0 : 1 );
}
catch ( Throwable $e )
{
    fwrite( STDERR, "BracketSmith: " . $e->getMessage() . "\n" );
    exit( 1 );
}
