{
    "name": "costamateus/bracketsmith",
    "description": "A lightweight PHP tool that polishes array formatting — keeping your brackets neat and consistent.",
    "type": "library",
    "license": "MIT",
    "authors": [{
        "name": "Mateus Costa",
        "email": "mateus@costamateus.com.br",
        "homepage": "https://github.com/costamateus"
    }],
    "require": {
        "php": "^8.1",
        "ext-tokenizer": "*"
    },
    "autoload": {
        "psr-4": {
            "BracketSmith\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BracketSmith\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/bracketsmith"
    ],
    "scripts": {
        "test": "@php vendor/bin/phpunit --bootstrap vendor/autoload.php --fail-on-deprecation --fail-on-warning --fail-on-risky --colors=always tests"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.5 || ^13.2"
    }
}
